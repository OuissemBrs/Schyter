// Broken variant of challenge_response: the reply carries no responder identity,
// it is just the initiator's nonce, in the clear.
//
// Nothing in the reply proves who produced it and nothing hides it, so a man in
// the middle learns the initiator's nonce simply by relaying the session, and an
// attacker who can open the first message can reflect the challenge straight
// back at Alice.

protocol cr_no_id(A,B) {
  role A {
    fresh na: Nonce;
    send_1(A,B, {A,na}k(A,B));
    recv_2(B,A, na);
    claim_A1(A,Secret,na);
    claim_A2(A,Alive);
    claim_A3(A,Niagree);
    claim_A4(A,Nisynch);
  }
  role B {
    var na: Nonce;
    recv_1(A,B, {A,na}k(A,B));
    send_2(B,A, na);
    claim_B1(B,Alive);
    claim_B2(B,Nisynch);
  }
}